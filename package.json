{
  "name": "planetx-spherex",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=30",
    "check:lint": "turbo run check:lint",
    "fix:lint": "turbo run fix:lint",
    "check:types": "turbo run check:types",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\"",
    "gen:docs": "turbo run gen:docs",
    "gen:docs-all": "NODE_OPTIONS='--max-old-space-size=4096' typedoc",
    "clean": "turbo run clean && rm -rf node_modules dist docs .turbo && echo 'Root Cleanup complete!'",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "commit": "git-cz",
    "prepare": "husky"
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@commitlint/prompt-cli": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@repo/constants": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/zod": "workspace:*",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "commitizen": "^4.3.2",
    "commitlint-plugin-tense": "^1.0.10",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.10.13",
    "tsdown": "^0.22.14",
    "tslib": "^2.3.0",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3"
  }
}
