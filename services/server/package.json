{
  "name": "server",
  "version": "26.4.1",
  "description": "",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx --watch ./src/index.ts",
    "build": "pnpm tsdown",
    "format": "prettier --write \"**/*.{ts,md,json,js,yaml}\"",
    "gen:docs": "NODE_OPTIONS='--max-old-space-size=4096' typedoc",
    "check:lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --max-warnings 1000",
    "fix:lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --fix --max-warnings=1000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --verbose",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx ./src/database/seeds/index.ts",
    "test": "vitest",
    "check:types": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "clean": "rm -rf node_modules dist docs && echo 'Cleanup complete!'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/request-ip": "^0.0.41",
    "@types/response-time": "^2.3.9",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "1.0.0-rc.4",
    "inquirer": "^14.1.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "express": "^5.2.1",
    "@repo/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "1.0.0-rc.4",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "googleapis": "^178.0.0",
    "inversify": "^8.2.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "random-words": "^2.0.1",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "request-ip": "^3.3.0",
    "resend": "^6.24.0",
    "response-time": "^2.3.4",
    "twilio": "^6.1.0",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.7"
  },
  "packageManager": "pnpm@11.0.0"
