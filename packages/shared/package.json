{
  "name": "@repo/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "gen:docs": "NODE_OPTIONS='--max-old-space-size=4096' typedoc",
    "check:lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --max-warnings 1000",
    "fix:lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --fix --max-warnings=1000",
    "check:types": "tsc --noEmit --listFiles",
    "clean": "rm -rf node_modules .turbo .next dist && echo 'Cleanup complete!'"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  }
}
